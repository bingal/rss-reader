{
  "name": "rss-reader",
  "version": "0.1.9",
  "description": "A fast, comfortable RSS reader desktop app built with ElectroBun",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "bun run src/bun/index.ts",
    "build": "vite build",
    "build:electron": "bun build src/bun/index.ts --compile --outfile dist/rss-reader",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@iconify-icon/react": "^3.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "clsx": "^2.1.1",
    "electrobun": "^1.14.4",
    "feed": "^5.2.0",
    "hono": "^4.7.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.5",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
